# Copy to .env and adjust. Every value has a sensible default.

# SQLite by default. For Postgres use e.g.:
# DATABASE_URL=postgresql+psycopg2://pricepulse:pricepulse@localhost:5432/pricepulse
DATABASE_URL=sqlite:///data/pricepulse.db

# Polite scraping
USER_AGENT=PricePulseBot/1.0 (+https://github.com/aghakazimali-ML/pricepulse; portfolio project)
MIN_DELAY_SECONDS=0.5
MAX_DELAY_SECONDS=1.5
MAX_CONCURRENCY=5
REQUEST_TIMEOUT_SECONDS=20
MAX_RETRIES=4
RESPECT_ROBOTS_TXT=true

# Sources
BOOKS_BASE_URL=https://books.toscrape.com/
QUOTES_JS_URL=https://quotes.toscrape.com/js/
# Optional: path to a Chromium binary if you don't want `playwright install chromium`
PLAYWRIGHT_CHROMIUM_EXECUTABLE=

# Loading: "changes" = new price snapshot only when price/stock changed (compact history)
#          "always"  = one snapshot per product per run
SNAPSHOT_MODE=changes

# Data quality thresholds
MIN_BOOK_ROWS=20
MIN_QUOTE_ROWS=5
MIN_PRICE=0.5
MAX_PRICE=1000
ROW_COUNT_CHANGE_WARN_PCT=20

LOG_LEVEL=INFO
